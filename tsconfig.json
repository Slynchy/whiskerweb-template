{
  "compilerOptions": {
    "paths": {
      "whiskerweb": ["./lib/whiskerweb/src"],
      "whiskerweb/*": ["./lib/whiskerweb/src/*"],
    },
    "outDir": "./dist/",
    "sourceMap": true,
    "strict": false,
    "noImplicitReturns": false,
    "moduleResolution": "node",
    "target": "es6",
    "jsx": "react"
  },
  "include": ["src/**/*"]
}